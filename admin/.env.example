# ─── API ───────────────────────────────────────────────────
# Absolute base URL of the API, including the /api/v1 prefix.
#
# Leave BLANK for local development: the client then falls back to the
# relative "/api/v1", which the Vite dev proxy forwards to the API (see
# VITE_API_PROXY_TARGET below). One origin in the browser means the httpOnly
# refresh cookie behaves exactly as it does in production.
#
# It MUST be set for any build served from a different origin than the API
# (Render, Netlify, S3...). Vite inlines this at BUILD time, so setting it on
# the host without a fresh build changes nothing. Left unset there, the app
# posts /api/v1/auth/login to the static site itself, which answers 200 with an
# empty body — and login fails with a destructuring TypeError, not a real error.
#
# Example: https://angelzbilling-server.onrender.com/api/v1
VITE_API_URL=

# ─── Dev server (vite.config.js only) ──────────────────────
# Port for `npm run dev`. Defaults to 5173.
VITE_DEV_PORT=5173

# Where the dev proxy forwards /api. Defaults to http://localhost:5000.
VITE_API_PROXY_TARGET=http://localhost:5000
