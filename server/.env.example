# ─── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# ─── Database ──────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/angelzperfume

# ─── JWT ───────────────────────────────────────────────────
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── CORS / Admin ──────────────────────────────────────────
ADMIN_URL=http://localhost:5173
COOKIE_DOMAIN=

# ─── Cloudinary ────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=angelzperfume

# ─── Rate limiting ─────────────────────────────────────────
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_MAX=20

# ─── Geo lookup upstreams ──────────────────────────────────
# Public address directories. Override to point at a mirror or internal proxy.
GEO_COUNTRIES_NOW_URL=https://countriesnow.space/api/v0.1
GEO_INDIA_POST_URL=https://api.postalpincode.in/pincode
GEO_ZIPPOPOTAM_URL=https://api.zippopotam.us
GEO_TIMEOUT_MS=8000

# ─── Proxy / rate limiting ─────────────────────────────────
# Number of proxies in front of the API. Must match reality: trusting more
# than exist lets a caller forge X-Forwarded-For and bypass every rate limit.
TRUST_PROXY_HOPS=1
REFRESH_RATE_LIMIT_MAX=60

# ─── Seeding (development only) ────────────────────────────
# Password for every account `npm run seed` creates. The seed refuses to run
# when NODE_ENV=production.
SEED_PASSWORD=
