# ─── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# ─── Database ──────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/angelzdesire

# ─── JWT ───────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── CORS / Admin ──────────────────────────────────────────
ADMIN_URL=http://localhost:5173

# ─── Cloudinary ────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=angelzdesire

# ─── Realtime (Socket.IO) ──────────────────────────────────
ENABLE_REALTIME=true
SOCKET_PATH=/socket.io
SOCKET_PING_INTERVAL_MS=25000
SOCKET_PING_TIMEOUT_MS=20000